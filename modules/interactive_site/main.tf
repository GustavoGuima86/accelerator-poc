# -----------------------------------------------------------------------------
# Public static website hosting the interactive benchmark page. Served over
# plain HTTP on purpose: an HTTPS page cannot call the HTTP endpoints it
# measures (direct S3 website, ALB, Global Accelerator IP) because browsers
# block mixed content. Demo-only; the page contains no secrets of value.
# -----------------------------------------------------------------------------
resource "random_id" "suffix" {
  byte_length = 4
}

resource "aws_s3_bucket" "site" {
  bucket        = "${var.project_name}-interactive-${random_id.suffix.hex}"
  force_destroy = true

  tags = {
    Purpose = "public-interactive-benchmark-page-demo-only"
  }
}

resource "aws_s3_bucket_public_access_block" "site" {
  bucket = aws_s3_bucket.site.id

  block_public_acls       = false
  block_public_policy     = false
  ignore_public_acls      = false
  restrict_public_buckets = false
}

resource "aws_s3_bucket_ownership_controls" "site" {
  bucket = aws_s3_bucket.site.id

  rule {
    object_ownership = "BucketOwnerPreferred"
  }
}

resource "aws_s3_bucket_website_configuration" "site" {
  bucket = aws_s3_bucket.site.id

  index_document {
    suffix = "index.html"
  }
}

data "aws_iam_policy_document" "public_read" {
  statement {
    sid    = "PublicReadGetObject"
    effect = "Allow"

    principals {
      type        = "*"
      identifiers = ["*"]
    }

    actions   = ["s3:GetObject"]
    resources = ["${aws_s3_bucket.site.arn}/*"]
  }
}

resource "aws_s3_bucket_policy" "site" {
  bucket = aws_s3_bucket.site.id
  policy = data.aws_iam_policy_document.public_read.json

  depends_on = [aws_s3_bucket_public_access_block.site]
}

resource "aws_s3_object" "index" {
  bucket        = aws_s3_bucket.site.id
  key           = "index.html"
  source        = var.index_html_path
  etag          = filemd5(var.index_html_path)
  content_type  = "text/html; charset=utf-8"
  cache_control = "no-cache"

  depends_on = [aws_s3_bucket_policy.site]
}

# Endpoint URLs are generated by Terraform, so the page itself stays static.
resource "aws_s3_object" "config" {
  bucket        = aws_s3_bucket.site.id
  key           = "config.js"
  content_type  = "application/javascript"
  cache_control = "no-cache"
  content       = "window.BENCH_CONFIG = ${nonsensitive(jsonencode(var.config))};\n"

  depends_on = [aws_s3_bucket_policy.site]
}
